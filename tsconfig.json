{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["chrome"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,

    /*
     * The migrated site parsers are plain JavaScript.
     *
     * They are the baseline's code, unchanged; the compat layer describes the
     * contract they implement. `allowJs` lets TypeScript resolve them so the
     * rest of the project can import them, and `checkJs` stays off so their
     * untyped internals are not reported.
     */
    "allowJs": true,
    "checkJs": false,

    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@ui/*": ["src/ui/*"],
      "@assets/*": ["src/assets/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.mjs",
    "tools/**/*.mjs",
    "*.config.ts",
    "*.config.mjs"
  ],
  "exclude": ["node_modules", "dist", "legacy"]
}
