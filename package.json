{
  "name": "kintsugi",
  "version": "2.0.0-alpha.1",
  "description": "Turn any web novel into a book worth keeping. A Firefox extension for scraping episodic fiction into clean EPUBs.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node tools/clean.mjs",
    "build": "node tools/build.mjs",
    "build:dev": "node tools/build.mjs --dev",
    "package": "node tools/package.mjs",
    "package:verify": "node tools/verify-xpi.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tools/e2e-harness.mjs run",
    "test:e2e:shots": "node tools/e2e-harness.mjs shots",
    "test:e2e:install-firefox": "playwright-core install firefox",
    "web-ext:lint": "node tools/lint-extension.mjs",
    "web-ext:lint:raw": "web-ext lint --source-dir dist",
    "web-ext:run": "web-ext run --source-dir dist",
    "links": "node tools/check-links.mjs",
    "check:text": "node tools/check-text-files.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:text && npm run test && npm run links && npm run build && npm run web-ext:lint && npm run package && npm run package:verify && npm run test:e2e",
    "precommit": "npm run lint && npm run typecheck && npm run check:text",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.8.0",
    "dompurify": "3.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/chrome": "0.1.28",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "happy-dom": "20.0.11",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
    "playwright-core": "1.65.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4",
    "web-ext": "8.10.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ],
    "tools/**/*.mjs": [
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.mjs": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
